APP_NAME="Central"
# Production: APP_ENV=production, APP_DEBUG=false (a debug page shows code and settings to whoever hits an error),
# APP_URL=https://... and SESSION_SECURE_COOKIE=true. See docs/DEPLOY.md.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# The screens speak English or Indonesian (Preferences → Other → Language, or each user's profile);
# numbers and dates follow the Indonesian convention (see App\Domain\Shared\Format).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# The first administrator, created by `php artisan erp:install` (or `db:seed`) when the command is not told otherwise.
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only: the schema will rely on row locks, partial unique indexes
# and jsonb, as an ERP's ledgers do. SQLite is not a target.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=central
DB_USERNAME=central
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over https only (set true in production).
SESSION_SECURE_COOKIE=false

# The proxies in front of the app (Caddy, nginx, a load balancer): addresses or ranges, comma-separated.
# Without it, behind a proxy every visitor looks like the proxy to the sign-in throttle and the audit log, and
# behind TLS every signed print link is refused (the app sees http). Name the proxy's address (127.0.0.1 when Caddy
# runs on the same server); * trusts whoever connects, so use it only when nothing but the proxy can reach PHP.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backups (php artisan central:backup): an S3-compatible bucket through the s3 disk
# (AWS_* above; AWS_ENDPOINT for R2 or B2). A local disk is not off the box.
BACKUP_DISK=local
BACKUP_PATH=backups
# php artisan central:backup-key; keep a copy off the server
BACKUP_ENCRYPTION_KEY=
# Health alerts go to every active administrator, plus this address when set
OPS_ALERT_EMAIL=
# WhatsApp alerts beside the mail (docs/BLUE-TEAM.md). Leave the provider empty until one is set up.
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_ALERT_TO=
