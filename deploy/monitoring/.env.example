# deploy/monitoring/.env: copy this file to .env beside it and fill it in.
# Read by docker compose and by the two cron scripts; never committed
# (the root .gitignore ignores .env at any depth).

# The site's domain; Grafana is reached at https://monitor.<DOMAIN> through Caddy.
DOMAIN=erp.example.co.id

# Grafana's own admin login (Caddy asks for its basic_auth password first).
GF_SECURITY_ADMIN_PASSWORD=change-me

# The same SMTP as Central's MAIL_* in /srv/central/.env; Grafana mails its alerts with it.
GF_SMTP_HOST=smtp.example.co.id:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=monitor@example.co.id
# Where Grafana's alerts go (one address; the mail server can forward to more).
ALERT_EMAIL=owner@example.co.id

# A read-only PostgreSQL role for Grafana and postgres_exporter; install.sh creates it.
MONITOR_DB_PASSWORD=change-me

# The queue key redis_exporter measures: Laravel's Redis prefix + queues:default.
# The prefix is REDIS_PREFIX in /srv/central/.env, or <app name slug>-database- when unset.
REDIS_QUEUE_KEY=central-database-queues:default

# rclone remote for the nightly log archive (ship-logs.sh): a bucket with a key that can
# write but not delete. Configure it as root with `rclone config`; the name goes here.
LOGS_RCLONE_REMOTE=logs-bucket:central-logs
