{
  "uid": "central-box",
  "title": "Central box",
  "tags": ["central"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "CPU", "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 } ] } } },
      "targets": [ { "refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))" } ] },
    { "id": 2, "type": "stat", "title": "Memory used", "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.92 } ] } } },
      "targets": [ { "refId": "A", "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes" } ] },
    { "id": 3, "type": "stat", "title": "Disk used (/)", "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.9 } ] } } },
      "targets": [ { "refId": "A", "expr": "1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}" } ] },
    { "id": 4, "type": "stat", "title": "Queue waiting", "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 } ] } } },
      "targets": [ { "refId": "A", "expr": "max(redis_key_size)" } ] },
    { "id": 5, "type": "stat", "title": "Certificate days left", "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "d", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 14 }, { "color": "green", "value": 30 } ] } } },
      "targets": [ { "refId": "A", "expr": "min(central_tls_cert_expiry_seconds) / 86400" } ] },
    { "id": 6, "type": "stat", "title": "Unexpected ports", "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "refId": "A", "expr": "sum(central_unexpected_listening_port) or vector(0)" } ] },
    { "id": 7, "type": "timeseries", "title": "Requests by status", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (status) (count_over_time({job=\"caddy\"} | json [5m]))", "legendFormat": "{{status}}" } ] },
    { "id": 8, "type": "timeseries", "title": "Network (bytes/s)", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[5m]))", "legendFormat": "in" },
        { "refId": "B", "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[5m]))", "legendFormat": "out" } ] },
    { "id": 9, "type": "timeseries", "title": "Failed sign-ins (panel + portal)", "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (context_guard) (count_over_time({job=\"central-security\"} | json | context_event = \"login_failed\" [15m]))", "legendFormat": "{{context_guard}}" } ] },
    { "id": 10, "type": "timeseries", "title": "CrowdSec bans", "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum(count_over_time({job=\"journal\", unit=\"crowdsec.service\"} |~ \"performed\" [15m]))", "legendFormat": "bans" } ] },
    { "id": 11, "type": "timeseries", "title": "PostgreSQL connections", "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(pg_stat_activity_count)", "legendFormat": "connections" } ] },
    { "id": 12, "type": "logs", "title": "SSH, sudo and CrowdSec", "gridPos": { "x": 0, "y": 20, "w": 12, "h": 10 },
      "datasource": { "uid": "loki" },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "expr": "{job=\"journal\"} |~ \"Accepted publickey|COMMAND=|performed|Failed password|Invalid user\"" } ] },
    { "id": 13, "type": "logs", "title": "Application errors", "gridPos": { "x": 12, "y": 20, "w": 12, "h": 10 },
      "datasource": { "uid": "loki" },
      "options": { "showTime": true, "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "expr": "{job=\"laravel\", level=~\"ERROR|CRITICAL|ALERT|EMERGENCY\"}" } ] }
  ]
}
